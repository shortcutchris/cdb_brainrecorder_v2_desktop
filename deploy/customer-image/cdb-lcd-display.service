[Unit]
Description=CDB USB timer display
After=cdb-recorder-studio.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/cdb-recorder-app/current
ExecStart=/opt/cdb/lcd-runtime/bin/python -m services.lcd_bridge --api-port 8088
Restart=always
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
UMask=0077
Nice=10
CPUQuota=10%
MemoryMax=128M
LimitAS=134217728
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=default.target
