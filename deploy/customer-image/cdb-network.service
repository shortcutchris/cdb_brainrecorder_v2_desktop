[Unit]
Description=Brain local Wi-Fi configuration
After=NetworkManager.service
Requires=NetworkManager.service
[Service]
ExecStart=/usr/bin/python3 /opt/cdb/factory/network_service.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=cdb-network
StateDirectory=cdb-network
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/NetworkManager/system-connections /var/lib/cdb-network /run/cdb-network
RestrictAddressFamilies=AF_UNIX AF_NETLINK
[Install]
WantedBy=multi-user.target
